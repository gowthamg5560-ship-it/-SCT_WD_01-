<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Areca Palm Products</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f8f3;
            color: #222;
            line-height: 1.6;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #14532d;
            color: white;
            z-index: 1000;
            transition: 0.3s;
        }

        .navbar.scrolled {
            background: #062d17;
            box-shadow: 0 3px 15px rgba(0,0,0,0.3);
        }

        .logo {
            font-size: 23px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #a7f3d0;
        }

        .menu-btn {
            display: none;
            font-size: 28px;
            cursor: pointer;
        }

        /* ================= HERO ================= */

        .hero {
            min-height: 100vh;
            background:
                linear-gradient(rgba(0,60,25,0.65), rgba(0,40,20,0.7)),
                url("https://images.unsplash.com/photo-1497250681960-ef046c08a56e?auto=format&fit=crop&w=1600&q=80");

            background-size: cover;
            background-position: center;

            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            padding: 100px 20px 40px;
        }

        .hero-content {
            max-width: 850px;
        }

        .hero h1 {
            font-size: 55px;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 21px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 13px 25px;
            background: #22c55e;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #15803d;
            transform: translateY(-3px);
        }

        /* ================= SECTIONS ================= */

        section {
            padding: 80px 7%;
        }

        .section-title {
            text-align: center;
            color: #166534;
            font-size: 35px;
            margin-bottom: 45px;
        }

        /* ================= CARDS ================= */

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .card {
            background: white;
            padding: 30px 20px;
            text-align: center;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.18);
        }

        .card-icon {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .card h3 {
            color: #166534;
            margin-bottom: 10px;
        }

        /* ================= INFORMATION ================= */

        .info-box {
            max-width: 900px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .info-box h3 {
            color: #166534;
            margin-bottom: 10px;
        }

        .info-box ul {
            padding-left: 25px;
        }

        /* ================= MARKET ================= */

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        th,
        td {
            padding: 15px;
            border: 1px solid #ddd;
            text-align: center;
        }

        th {
            background: #166534;
            color: white;
        }

        tr:hover {
            background: #ecfdf5;
        }

        .price {
            color: #15803d;
            font-weight: bold;
        }

        .demo-note {
            margin-top: 15px;
            text-align: center;
            color: #777;
            font-size: 14px;
        }

        /* ================= WEATHER ================= */

        .weather-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            max-width: 900px;
            margin: auto;
        }

        select {
            width: 100%;
            padding: 14px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        .weather-card {
            background: linear-gradient(135deg, #16a34a, #065f46);
            color: white;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
        }

        .weather-temp {
            font-size: 45px;
            font-weight: bold;
            margin: 10px 0;
        }

        .weather-details {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .weather-detail {
            background: rgba(255,255,255,0.15);
            padding: 12px;
            border-radius: 8px;
        }

        /* ================= TOOLS ================= */

        .tools {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .tool-card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .tool-card h3 {
            color: #166534;
            margin-bottom: 10px;
        }

        /* ================= CONTACT ================= */

        .contact-container {
            max-width: 800px;
            margin: auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .contact-info,
        .contact-form {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .contact-info h3,
        .contact-form h3 {
            color: #166534;
            margin-bottom: 20px;
        }

        .contact-info p {
            margin: 15px 0;
        }

        input,
        textarea {
            width: 100%;
            padding: 13px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 15px;
        }

        textarea {
            height: 130px;
            resize: vertical;
        }

        button {
            border: none;
            cursor: pointer;
            padding: 13px 25px;
            border-radius: 8px;
            background: #16a34a;
            color: white;
            font-size: 16px;
            font-weight: bold;
        }

        button:hover {
            background: #15803d;
        }

        /* ================= FOOTER ================= */

        footer {
            background: #052e16;
            color: white;
            text-align: center;
            padding: 30px 20px;
        }

        footer p {
            margin: 5px;
        }

        /* ================= MOBILE ================= */

        @media(max-width: 900px) {

            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .tools {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero h1 {
                font-size: 42px;
            }
        }

        @media(max-width: 650px) {

            .navbar {
                padding: 15px 5%;
            }

            .menu-btn {
                display: block;
            }

            .nav-links {
                position: absolute;
                top: 65px;
                left: -100%;
                width: 100%;
                background: #14532d;
                flex-direction: column;
                text-align: center;
                padding: 20px;
                transition: 0.3s;
            }

            .nav-links.active {
                left: 0;
            }

            .cards,
            .tools,
            .weather-container,
            .contact-container {
                grid-template-columns: 1fr;
            }

            .weather-details {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 35px;
            }

            .hero p {
                font-size: 17px;
            }

            section {
                padding: 60px 5%;
            }
        }
    </style>
</head>

