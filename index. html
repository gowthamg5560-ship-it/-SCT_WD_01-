    margin-bottom:10px;

}

.card p{

    color:var(--gray);

    line-height:1.6;

}


/* ================= WEATHER ================= */

.weather{

    background:var(--light);

}

.weather-controls{

    max-width:600px;

    margin:auto;

    display:flex;

    gap:10px;

    flex-wrap:wrap;

    margin-bottom:30px;

}

select{

    flex:1;

    min-width:220px;

    padding:14px;

    border-radius:10px;

    border:1px solid #ccd8ce;

    font-size:16px;

}

.weather-card{

    max-width:800px;

    margin:auto;

    background:white;

    border-radius:25px;

    padding:35px;

    box-shadow:var(--shadow);

    text-align:center;

}

.weather-icon{

    font-size:65px;

    margin:15px;

}

.temperature{

    font-size:55px;

    color:var(--green);

    font-weight:bold;

}

.weather-grid{

    display:grid;

    grid-template-columns:
        repeat(auto-fit,minmax(130px,1fr));

    gap:15px;

    margin-top:30px;

}

.weather-item{

    background:var(--light);

    padding:18px;

    border-radius:12px;

}

.weather-item b{

    display:block;

    margin-top:7px;

}


/* ================= MARKET ================= */

.market-search{

    max-width:500px;

    margin:0 auto 30px;

}

.market-search input{

    width:100%;

    padding:15px;

    border:1px solid #ccd8ce;

    border-radius:10px;

    font-size:16px;

}

.table-wrapper{

    overflow-x:auto;

    background:white;

    box-shadow:var(--shadow);

    border-radius:15px;

