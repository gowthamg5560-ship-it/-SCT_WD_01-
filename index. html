<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

:root{

    --green:#087f23;
    --dark:#064d18;
    --light:#effaf1;
    --yellow:#f5c542;
    --white:#ffffff;
    --text:#18231b;
    --gray:#68736b;
    --shadow:0 10px 30px rgba(0,0,0,.10);

}

body{

    font-family:
