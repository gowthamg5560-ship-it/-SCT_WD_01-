                ${data.temp}°C
            </div>

            <p>
                ${data.condition}
            </p>

            <div class="weather-details">

                <div class="weather-detail">
                    💧<br>
                    <b>${data.humidity}%</b><br>
                    Humidity
                </div>

                <div class="weather-detail">
                    🌧️<br>
                    <b>${data.rain} mm</b><br>
                    Rain
                </div>

                <div class="weather-detail">
                    💨<br>
                    <b>${data.wind} km/h</b><br>
                    Wind
                </div>

            </div>

        `;

    }


