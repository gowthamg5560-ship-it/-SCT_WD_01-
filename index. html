/* =====================================================
   WEATHER DESCRIPTION
===================================================== */

function weatherDescription(code){

    if(code === 0)
        return ["☀️","Clear sky"];

    if(code <= 3)
        return ["🌤️","Partly cloudy"];

    if(code <= 48)
        return ["🌫️","Fog"];

    if(code <= 57)
        return ["🌦️","Drizzle"];

    if(code <= 67)
        return ["🌧️","Rain"];

    if(code <= 82)
        return ["🌧️","Rain showers"];

    if(code <= 86)
        return ["🌨️","Snow showers"];

    if(code >= 95)
        return ["⛈️","Thunderstorm"];

    return ["🌤️","Variable weather"];

}


/* =====================================================
   LOAD DISTRICTS
===================================================== */

async function loadDistricts(){

    try{

        const response =
            await fetch("/api/districts");

        const districts =
            await response.json();

        const select =
            document.getElementById(
                "districtSelect"
            );

        select.innerHTML = "";

        districts.forEach(
            (district,index) => {

                const option =
                    document.createElement(
                        "option"
                    );

                option.value =
                    `${district.lat},${district.lon}`;

                option.dataset.name =
                    district.name;

                option.textContent =
                    district.name;

                select.appendChild(option);

            }
        );

        await loadWeather();

    }

    catch(error){

        console.error(error);

    }

}


/* =====================================================
   LOAD WEATHER
===================================================== */

async function loadWeather(){

    const select =
        document.getElementById(
            "districtSelect"
        );

    const option =
        select.options[
            select.selectedIndex
        ];

    if(!option)
        return;

    const [lat,lon] =
        option.value.split(",");

    const name =
        option.dataset.name;

    const card =
        document.getElementById(
            "weatherCard"
        );

    card.innerHTML =
        "Loading latest weather...";


    try{

        const response =
            await fetch(
                `/api/weather?lat=${lat}&lon=${lon}`
            );

        const data =
            await response.json();

        if(data.error)
            throw new Error(data.error);


        const current =
            data.current;

        const weather =
            weatherDescription(
                current.weather_code
            );


        card.innerHTML = `

            <h2>
                ${name}
            </h2>

            <div class="weather-icon">
                ${weather[0]}
            </div>

            <div class="temperature">
                ${Math.round(
                    current.temperature_2m
                )}°C
            </div>

            <p>
                ${weather[1]}
            </p>


            <div class="weather-grid">

                <div class="weather-item">
                    💧 Humidity
                    <b>
                        ${current.relative_humidity_2m}%
                    </b>
                </div>

                <div class="weather-item">
                    🌡️ Feels Like
                    <b>
                        ${Math.round(
                            current.apparent_temperature
                        )}°C
                    </b>
                </div>

                <div class="weather-item">
                    🌧️ Rain
                    <b>
                        ${current.precipitation} mm
                    </b>
                </div>

                <div class="weather-item">
                    💨 Wind
                    <b>
                        ${Math.round(
                            current.wind_speed_10m
                        )} km/h
                    </b>
                </div>

                <div class="weather-item">
                    📅 Updated
                    <b>
                        ${current.time.replace(
                            "T",
                            " "
                        )}
                    </b>
                </div>

            </div>

        `;

    }

    catch(error){

        card.innerHTML = `

            <h3>
                Weather unavailable
            </h3>

            <p>
                Please try again.
            </p>

        `;

        console.error(error);

    }

}


/* =====================================================
   LOAD MARKET
===================================================== */

async function loadMarket(){

    const body =
        document.getElementById(
            "marketBody"
        );

    try{

        const response =
            await fetch(
                "/api/market-prices"
            );

        const result =
            await response.json();

        body.innerHTML = "";

        result.data.forEach(
            item => {

                const row =
                    document.createElement(
                        "tr"
                    );

                row.innerHTML = `

                    <td>
                        ${item.district}
                    </td>

                    <td>
                        ${item.market}
                    </td>

                    <td>
                        ${item.commodity}
                    </td>

                    <td>
                        ${
                            item.min === null
                            ? "-"
                            : "₹" + item.min
                        }
                    </td>

                    <td>
                        ${
                            item.max === null
                            ? "-"
                            : "₹" + item.max
                        }
                    </td>

                    <td>
                        ${
                            item.modal === null
                            ? "-"
                            : "₹" + item.modal
                        }
                    </td>

                    <td class="no-data">
                        ${item.status}
                    </td>

                `;

                body.appendChild(row);

            }
        );

    }

    catch(error){

        body.innerHTML = `

            <tr>

                <td colspan="7">
                    Market data unavailable.
                </td>

            </tr>

        `;

    }

}


